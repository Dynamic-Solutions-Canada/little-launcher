{
  "worktree": {
    "setup": [
      "git submodule update --init --recursive",
      "npm ci --prefix linux/browser --no-audit --no-fund",
      "lefthook install"
    ],
    "teardown": "git submodule deinit --all --force"
  },
  "scripts": {
    "verify-desktop": {
      "command": "npm run verify:desktop"
    },
    "package-desktop-dev": {
      "command": "npm run package:desktop:dev"
    },
    "install-desktop": {
      "command": "npm run install:desktop"
    },
    "package-desktop": {
      "command": "npm run package:desktop"
    },
    "validate": {
      "command": "npm run validate"
    },
    "test": {
      "command": "npm test"
    },
    "test-linux": {
      "command": "npm run test:linux"
    },
    "icons": {
      "command": "npm run icons"
    }
  }
}
