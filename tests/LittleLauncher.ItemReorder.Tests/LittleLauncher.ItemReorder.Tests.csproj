<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Match the app's generator so tests compile the real observable model. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <Compile Include="../../LittleLauncher/Models/LauncherItem.cs" Link="LauncherItem.cs" />
    <Compile Include="../../LittleLauncher/Controls/LauncherItemReorder.cs" Link="LauncherItemReorder.cs" />
    <Compile Include="../../LittleLauncher/Controls/LauncherDropGeometry.cs" Link="LauncherDropGeometry.cs" />
  </ItemGroup>
  <!-- LauncherItem's accessible names read through the real language layer. -->
  <ItemGroup>
    <Compile Include="../../Shared/SupportedLanguages.cs" Link="SupportedLanguages.cs" />
    <Compile Include="../../Shared/UiText.cs" Link="UiText.cs" />
    <EmbeddedResource Include="../../Shared/Localization/**/*.json"
                      LogicalName="LittleLauncher.Localization.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
