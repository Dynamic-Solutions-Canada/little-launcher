<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <!-- The real OAuth client and token model; only protected storage and logging are adapted. -->
  <ItemGroup>
    <Compile Include="../../LittleLauncher/Services/OAuthPkceClient.cs" Link="OAuthPkceClient.cs" />
    <Compile Include="../../LittleLauncher/Services/CloudTokenStore.cs" Link="CloudTokenStore.cs" />
  </ItemGroup>
  <!-- The real language layer and catalogs, embedded exactly as LittleLauncher.csproj does. -->
  <ItemGroup>
    <Compile Include="../../Shared/SupportedLanguages.cs" Link="SupportedLanguages.cs" />
    <Compile Include="../../Shared/UiText.cs" Link="UiText.cs" />
    <EmbeddedResource Include="../../Shared/Localization/**/*.json"
                      LogicalName="LittleLauncher.Localization.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
