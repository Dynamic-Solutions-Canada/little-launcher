<Project>
  <!-- The family's shared build properties (KIT-9): platform auto-detect, language settings,
       analyzers, warnings as errors in Release and CI, and the security floors. -->
  <Import Project="$(MSBuildThisFileDirectory)external/winui-app-kit/build/WinUIAppKit.props" />

  <!--
    Local build secrets, untracked. Holds the OAuth client secret that cannot live in a public
    repository but is compiled into shipped builds. Fresh clones and CI have no private file;
    shipping CI supplies the GoogleClientSecret build environment variable instead. Availability
    checks only the client ID, not the presence of a secret. See docs/sync.md.
  -->
  <Import Project="$(MSBuildThisFileDirectory)local.secrets.props"
          Condition="Exists('$(MSBuildThisFileDirectory)local.secrets.props')" />

  <!-- Single source of truth for the app version; the packaging script, the build tooling and the
       release workflows read the one <Version> element in this file. -->
  <PropertyGroup>
    <Version>1.44.1</Version>
  </PropertyGroup>
</Project>
