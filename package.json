{
  "name": "little-launcher",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "package:desktop:dev": "external/winui-app-kit/scripts/windows-build --dev",
    "verify:desktop": "external/winui-app-kit/scripts/windows-build --build-only --configuration Debug",
    "install:desktop": "external/winui-app-kit/scripts/windows-build --install",
    "package:desktop": "external/winui-app-kit/scripts/windows-build --no-sign",
    "test": "external/winui-app-kit/scripts/run-tests && npm run test:linux",
    "test:linux": "PYTHONPATH=linux python3 -m unittest discover -s linux/tests -v && node --test linux/tests/*.test.cjs",
    "check:l10n": "PYTHONPATH=linux python3 -m unittest -v linux.tests.test_localization",
    "check:gitignore": "external/winui-app-kit/scripts/check-gitignore .",
    "check:listing": "python3 external/winui-app-kit/scripts/check-listing.py",
    "generate:notices": "python3 external/winui-app-kit/scripts/generate-notices.py",
    "check:notices": "python3 external/winui-app-kit/scripts/generate-notices.py --check",
    "shots:render": "python3 external/winui-app-kit/scripts/store/render-screenshots.py",
    "check:screenshots": "python3 external/winui-app-kit/scripts/store/render-screenshots.py --check",
    "icons": "external/winui-app-kit/scripts/devkit icons",
    "check:icons": "external/winui-app-kit/scripts/devkit icons --check",
    "format": "external/winui-app-kit/scripts/format",
    "format:check": "external/winui-app-kit/scripts/format --check",
    "validate": "npm run format:check && npm run check:notices && npm run check:gitignore && npm run check:icons && npm run check:l10n && npm run check:listing && npm run check:screenshots && npm test",
    "start:linux": "linux/bin/little-launcher",
    "package:linux": "python3 linux/packaging/build.py"
  }
}
