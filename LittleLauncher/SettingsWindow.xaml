<Window
    x:Class="LittleLauncher.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:kit="using:WinUIAppKit.Pages"
    Title="Little Launcher">
    <!-- The family's settings shell (UI-1, UI-2): title bar, navigation and the fixed footer
         ("Our other apps", About, Settings). Little Launcher adds its own pages in code. -->
    <kit:SettingsShell x:Name="Shell" />
</Window>
