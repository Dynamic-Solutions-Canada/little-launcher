<Page x:Class="LittleLauncher.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:LittleLauncher.Localization">

    <!-- Home (UI-3): the product's name and tagline, any standing notices, then a card for each
         part of the app. Version and build type live on the kit's About page. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="PageContent" Style="{StaticResource PageContentStyle}">
        <TextBlock Text="Little Launcher" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{l:Str Key=about.description}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Update banner (hidden by default) -->
        <InfoBar x:Name="UpdateInfoBar"
                 Title="{l:Str Key=about.update.availableTitle}"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Informational">
            <InfoBar.ActionButton>
                <Button x:Name="UpdateActionButton" Content="{l:Str Key=about.update.viewRelease}" Click="UpdateAction_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- One-time notice after upgrading, opened by SettingsManager's upgrade check.
             Store updates install silently, so this is the only channel that reaches
             those users at all. -->
        <InfoBar x:Name="WhatsNewInfoBar"
                 Title="{l:Str Key=home.whatsNew.title}"
                 Message="{l:Str Key=home.whatsNew.message}"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Success"
                 CloseButtonClick="WhatsNewInfoBar_CloseButtonClick">
            <InfoBar.ActionButton>
                <Button Content="{l:Str Key=home.whatsNew.action}" Click="WhatsNewAction_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <TextBlock Text="{l:Str Key=home.title}" Style="{StaticResource SectionHeaderStyle}" />

        <!-- Buttons styled as cards, so they take keyboard focus and announce their label. -->
        <Button Style="{StaticResource NavigationCardButtonStyle}" Click="LauncherItems_Click"
                AutomationProperties.Name="{l:Str Key=launchers.title}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xF0E2;" FontSize="28" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:Str Key=launchers.title}" />
                    <TextBlock Text="{l:Str Key=home.launchersCard.description}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Button>

        <Button Style="{StaticResource NavigationCardButtonStyle}" Click="SyncSettings_Click"
                AutomationProperties.Name="{l:Str Key=sync.title}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE895;" FontSize="28" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:Str Key=sync.title}" />
                    <TextBlock Text="{l:Str Key=home.syncCard.description}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Button>
    </StackPanel>
    </ScrollViewer>
</Page>
