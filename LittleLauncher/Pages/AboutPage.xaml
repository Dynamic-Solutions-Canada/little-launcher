<Page x:Class="LittleLauncher.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:LittleLauncher.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
    <StackPanel MaxWidth="1000" Margin="16">
        <TextBlock Text="{l:Str Key=about.title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="24" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Little Launcher" FontSize="16" FontWeight="Medium"/>
                    <TextBlock Text="{l:Str Key=about.description}"
                               FontSize="13" Opacity="0.6" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE943;" FontSize="24" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{l:Str Key=about.builtWith}" FontSize="14" FontWeight="Medium"/>
                    <TextBlock TextWrapping="Wrap" Text="WinUI 3 · .NET 10 · Windows App SDK · CommunityToolkit.Mvvm · SSH.NET · NLog"
                               FontSize="12" Opacity="0.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE12B;" FontSize="24" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{l:Str Key=about.sourceCode.title}" FontSize="14" FontWeight="Medium"/>
                    <TextBlock TextWrapping="Wrap" Text="{l:Str Key=about.sourceCode.description}" FontSize="12" Opacity="0.5"/>
                </StackPanel>
                <HyperlinkButton x:Name="SourceCodeLink" Grid.Column="2" Content="{l:Str Key=about.sourceCode.link}"
                                 VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border x:Name="UpdateCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE895;" FontSize="24" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{l:Str Key=about.update.title}" FontSize="14" FontWeight="Medium"/>
                    <TextBlock TextWrapping="Wrap" x:Name="UpdateStatusText" Text="{l:Str Key=about.update.clickToCheck}" FontSize="12" Opacity="0.5"/>
                </StackPanel>
                <Button x:Name="CheckUpdateButton" Grid.Column="2" Content="{l:Str Key=about.update.checkButton}" Click="CheckForUpdates_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
