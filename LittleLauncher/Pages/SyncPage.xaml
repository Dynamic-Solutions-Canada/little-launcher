<Page x:Class="LittleLauncher.Pages.SyncPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:LittleLauncher.Localization">

    <Page.Resources>
        <!-- Every destination expander looks the same: full width, content stretched, so the
             rows read as one list rather than five differently-sized cards. -->
        <Style x:Key="DestinationExpander" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
    <StackPanel MaxWidth="1000" Margin="16">
        <TextBlock Text="{l:Str Key=sync.title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{l:Str Key=sync.description}"
                   FontSize="14" Opacity="0.6" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <TextBlock Text="{l:Str Key=sync.destinations.title}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBlock Text="{l:Str Key=sync.destinations.description}"
                   FontSize="12" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <!-- ── SSH / SFTP ── -->


        <!-- ── OneDrive ── -->
        <Expander x:Name="OneDriveExpander" Style="{StaticResource DestinationExpander}">
            <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE753;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="OneDrive" FontSize="14"/>
                        <TextBlock x:Name="OneDriveStatus" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="OneDriveToggle" Tag="1"
                                  OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="Destination_Toggled"/>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <TextBlock x:Name="OneDriveHint" FontSize="12" Opacity="0.6"
                           Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OneDriveSignIn" Content="{l:Str Key=sync.signInButton}" Tag="1" Click="SignIn_Click"/>
                    <Button x:Name="OneDriveSignOut" Content="{l:Str Key=common.signOut}" Tag="1" Click="SignOut_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
                <InfoBar x:Name="OneDriveNotice" IsOpen="False" IsClosable="False"
                         Severity="Informational" Margin="0,8,0,0"/>
            </StackPanel>
        </Expander>

        <!-- ── Google Drive ── -->
        <Expander x:Name="GoogleExpander" Style="{StaticResource DestinationExpander}">
            <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE753;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Google Drive" FontSize="14"/>
                        <TextBlock x:Name="GoogleStatus" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="GoogleToggle" Tag="2"
                                  OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="Destination_Toggled"/>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <TextBlock x:Name="GoogleHint" FontSize="12" Opacity="0.6"
                           Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="GoogleSignIn" Content="{l:Str Key=sync.signInButton}" Tag="2" Click="SignIn_Click"/>
                    <Button x:Name="GoogleSignOut" Content="{l:Str Key=common.signOut}" Tag="2" Click="SignOut_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
                <InfoBar x:Name="GoogleNotice" IsOpen="False" IsClosable="False"
                         Severity="Informational" Margin="0,8,0,0"/>
            </StackPanel>
        </Expander>

        <!-- ── WebDAV ── -->
        <Expander x:Name="WebDavExpander" Style="{StaticResource DestinationExpander}">
            <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:Str Key=sync.webDav.title}" FontSize="14"/>
                        <TextBlock x:Name="WebDavStatus" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="WebDavToggle" Tag="5"
                                  OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="Destination_Toggled"/>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71B;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{l:Str Key=sync.webDav.folderUrl}" FontSize="14"/>
                            <TextBlock Text="{l:Str Key=sync.webDav.folderUrlExample}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBox Grid.Column="2" Width="320" VerticalAlignment="Center"
                                 Text="{Binding WebDavUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE77B;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{l:Str Key=sync.webDav.username}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Width="240" VerticalAlignment="Center"
                                 Text="{Binding WebDavUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{l:Str Key=sync.webDav.password}" FontSize="14"/>
                            <TextBlock x:Name="WebDavPasswordHint" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PasswordBox x:Name="WebDavPasswordBox" Width="200"/>
                            <Button x:Name="WebDavConnectButton" Content="{l:Str Key=sync.webDav.connect}" Click="WebDavConnect_Click"/>
                            <Button x:Name="WebDavDisconnectButton" Content="{l:Str Key=sync.webDav.forget}" Tag="5" Click="SignOut_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="WebDavNotice" IsOpen="False" IsClosable="False"
                         Severity="Informational" Margin="0,4,0,0"/>
            </StackPanel>
        </Expander>

        <!-- ── Folder / network share ── -->
        <Expander x:Name="FolderExpander" Style="{StaticResource DestinationExpander}">
            <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:Str Key=sync.folder.title}" FontSize="14"/>
                        <TextBlock x:Name="FolderStatus" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="FolderToggle" Tag="4"
                                  OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="Destination_Toggled"/>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <TextBlock Text="{l:Str Key=sync.folder.description}"
                           FontSize="12" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{l:Str Key=sync.folder.label}" FontSize="14" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:Name="FolderBox" Width="280"
                                     Text="{Binding SyncFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="{l:Str Key=common.browse}" Click="BrowseFolder_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Expander>

        <Expander x:Name="SftpExpander" Style="{StaticResource DestinationExpander}">
            <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE968;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:Str Key=sync.sftp.title}" FontSize="14"/>
                        <TextBlock x:Name="SftpStatus" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="SftpToggle" Tag="0"
                                  OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="Destination_Toggled"/>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE770;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{l:Str Key=sync.sftp.host}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding SftpHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Str Key=sync.sftp.hostPlaceholder}" Width="200"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71B;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{l:Str Key=sync.sftp.port}" FontSize="14" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="2" x:Name="PortBox" Value="{Binding SftpPort, Mode=TwoWay}" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" Width="90"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE77B;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{l:Str Key=sync.sftp.username}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding SftpUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Str Key=sync.sftp.usernamePlaceholder}" Width="200"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Str Key=sync.sftp.privateKeyPath}" FontSize="14"/>
                            <TextBlock TextWrapping="Wrap" Text="{l:Str Key=sync.sftp.privateKeyDescription}" FontSize="12" Opacity="0.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBox Text="{Binding SftpPrivateKeyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="~/.ssh/id_rsa" Width="200" Margin="0,0,8,0"/>
                            <Button Content="{l:Str Key=common.browse}" Click="BrowseKey_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Str Key=sync.sftp.remotePath}" FontSize="14"/>
                            <TextBlock TextWrapping="Wrap" Text="{l:Str Key=sync.sftp.remotePathDescription}" FontSize="12" Opacity="0.5"/>
                        </StackPanel>
                        <TextBox Grid.Column="2" Text="{Binding SftpRemotePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                    </Grid>
                </Border>

                <TextBlock Text="{l:Str Key=sync.sftp.exportImportDescription}"
                           FontSize="12" Opacity="0.6" Margin="0,8,0,6" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Str Key=sync.sftp.exportConnection}" Click="ExportSshConfig_Click"/>
                    <Button Content="{l:Str Key=sync.sftp.importConnection}" Click="ImportSshConfig_Click"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- ── Shared by every destination ── -->
        <TextBlock Text="{l:Str Key=sync.auto.section}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE72C;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:Str Key=sync.auto.title}" FontSize="14"/>
                    <TextBlock TextWrapping="Wrap" Text="{l:Str Key=sync.auto.description}" FontSize="12" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding SftpAutoSync, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE823;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:Str Key=sync.auto.interval}" FontSize="14"/>
                    <TextBlock TextWrapping="Wrap" Text="{l:Str Key=sync.auto.intervalDescription}" FontSize="12" Opacity="0.5"/>
                </StackPanel>
                <NumberBox Grid.Column="2" Value="{Binding SftpAutoSyncInterval, Mode=TwoWay}" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Compact" Width="140"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <TextBlock Text="{l:Str Key=sync.actions.title}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
            <Button x:Name="TestButton" Content="{l:Str Key=sync.actions.testAll}" Click="TestConnection_Click"/>
            <Button Content="{l:Str Key=sync.actions.upload}" Click="Upload_Click"/>
            <Button Content="{l:Str Key=sync.actions.download}" Click="Download_Click"/>
        </StackPanel>

        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Margin="0,0,0,8"/>

        <!-- Password prompt (SFTP only, shown when needed) -->
        <Border x:Name="PasswordCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8D7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{l:Str Key=sync.passwordPrompt}" FontSize="14" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <PasswordBox x:Name="PasswordBox" Width="200" Margin="0,0,8,0"/>
                    <Button Content="{l:Str Key=common.ok}" Click="PasswordOk_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
