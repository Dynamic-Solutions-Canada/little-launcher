<Page x:Class="LittleLauncher.Pages.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:LittleLauncher.Localization"
      xmlns:l10n="using:WinUIAppKit.Localization"
      xmlns:kitc="using:WinUIAppKit.Controls">

    <!-- The Settings page (UI-4): the kit's shared rows first (Start with Windows, Language, App
         theme), then Little Launcher's own, then Reset settings in its own card at the end. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock l10n:Localize.Text="kit.settings.title" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="{l:Str Key=system.appearance}" Style="{StaticResource FirstSectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <kitc:StartupSetting x:Name="StartupRow" />

                    <StackPanel Spacing="4">
                        <kitc:LanguageSetting x:Name="LanguageRow" />
                        <TextBlock Text="{l:Str Key=system.language.description}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <kitc:ThemeSetting x:Name="ThemeRow" />

                    <StackPanel Spacing="4">
                        <ToggleSwitch Header="{l:Str Key=system.animations.title}"
                                      l10n:Localize.OnContent="kit.settings.on" l10n:Localize.OffContent="kit.settings.off"
                                      IsOn="{Binding FlyoutAnimationsEnabled, Mode=TwoWay}" />
                        <TextBlock Text="{l:Str Key=system.animations.description}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Start Menu shortcuts for web launchers. Shown in the positive;
                         DisableWebLauncherShortcuts is stored in the negative (the schema 0 rule in
                         user-settings.md), and the inversion lives in the code-behind. -->
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="WebShortcutsToggle" Header="{l:Str Key=system.startMenu.title}"
                                      l10n:Localize.OnContent="kit.settings.on" l10n:Localize.OffContent="kit.settings.off"
                                      Toggled="WebShortcutsToggle_Toggled" />
                        <TextBlock Text="{l:Str Key=system.startMenu.description}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar x:Name="LanguageRestartBar" IsOpen="False" IsClosable="False" Severity="Informational"
                     Message="{l:Str Key=system.language.restartNote}" />
            <TextBlock Text="{l:Str Key=system.trayNote}" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Browser extensions -->
            <TextBlock Text="{l:Str Key=system.extensions.section}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:Str Key=system.extensions.title}" />
                    <TextBlock Text="{l:Str Key=system.extensions.description}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="{l:Str Key=system.extensions.addFolder}" Click="AddExtensionButton_Click" />
                    <StackPanel x:Name="ExtensionList" Spacing="4" />
                </StackPanel>
            </Border>

            <!-- Unused browser profiles -->
            <TextBlock Text="{l:Str Key=system.storage}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:Str Key=system.profiles.title}" />
                    <TextBlock x:Name="ProfileCleanupSubtitle" Text="{l:Str Key=system.profiles.checking}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ProfileCleanupButton" Content="{l:Str Key=common.delete}"
                            Click="ProfileCleanupButton_Click" IsEnabled="False" />
                </StackPanel>
            </Border>

            <!-- Backup and restore -->
            <TextBlock Text="{l:Str Key=system.backup.section}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:Str Key=system.backup.title}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:Str Key=system.backup.export}" Click="ExportButton_Click" />
                        <Button Content="{l:Str Key=system.backup.import}" Click="ImportButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Reset settings (CONF-4): preferences only; launchers and sync setup are kept. -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0">
                <kitc:ResetSetting x:Name="ResetRow" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
