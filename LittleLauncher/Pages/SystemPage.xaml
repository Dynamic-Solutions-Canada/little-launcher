<Page x:Class="LittleLauncher.Pages.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:LittleLauncher.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
    <StackPanel MaxWidth="1000" Margin="16">
        <TextBlock Text="{l:Str Key=common.settings}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>

        <!-- Appearance -->
        <TextBlock Text="{l:Str Key=system.appearance}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{l:Str Key=system.theme.title}" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="2" SelectedIndex="{Binding AppTheme, Mode=TwoWay}">
                    <ComboBoxItem Content="{l:Str Key=system.theme.systemDefault}"/>
                    <ComboBoxItem Content="{l:Str Key=system.theme.light}"/>
                    <ComboBoxItem Content="{l:Str Key=system.theme.dark}"/>
                </ComboBox>
            </Grid>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xF2B7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:Str Key=system.language.title}" FontSize="14"/>
                    <TextBlock Text="{l:Str Key=system.language.description}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox x:Name="LanguageCombo" Grid.Column="2" MinWidth="200" MaxWidth="280" Margin="12,0,0,0"
                          SelectionChanged="LanguageCombo_SelectionChanged"/>
            </Grid>
        </Border>
        <TextBlock x:Name="LanguageRestartNote" Visibility="Collapsed" TextWrapping="Wrap"
                   FontSize="12" Opacity="0.7" Margin="16,0,16,8"
                   Text="{l:Str Key=system.language.restartNote}"/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7FC;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:Str Key=system.animations.title}" FontSize="14"/>
                    <TextBlock TextWrapping="Wrap" Text="{l:Str Key=system.animations.description}" FontSize="12" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                              IsOn="{Binding FlyoutAnimationsEnabled, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- Start Menu shortcuts for web launchers. Shown in the positive; DisableWebLauncherShortcuts
             is stored in the negative so it survives WhenWritingDefault, and the inversion lives in
             the code-behind rather than in the model. -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE71D;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:Str Key=system.startMenu.title}" FontSize="14"/>
                    <TextBlock Text="{l:Str Key=system.startMenu.description}"
                               FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch x:Name="WebShortcutsToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                              Toggled="WebShortcutsToggle_Toggled"/>
            </Grid>
        </Border>

        <TextBlock Text="{l:Str Key=system.trayNote}"
                   FontSize="12" Opacity="0.55" Margin="0,4,0,4"/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8FC;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:Str Key=system.startup.title}" FontSize="14"/>
                    <TextBlock TextWrapping="Wrap" Text="{l:Str Key=system.startup.description}" FontSize="12" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="2" x:Name="StartupSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="StartupSwitch_Toggled" IsOn="{Binding Startup, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- Browser extensions -->
        <TextBlock Text="{l:Str Key=system.extensions.section}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE71D;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:Str Key=system.extensions.title}" FontSize="14"/>
                        <TextBlock FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                   Text="{l:Str Key=system.extensions.description}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{l:Str Key=system.extensions.addFolder}" Click="AddExtensionButton_Click"/>
                </Grid>
                <StackPanel x:Name="ExtensionList" Spacing="4" Margin="36,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Unused browser profiles -->
        <TextBlock Text="{l:Str Key=system.storage}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE74E;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:Str Key=system.profiles.title}" FontSize="14"/>
                    <TextBlock x:Name="ProfileCleanupSubtitle" FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                               Text="{l:Str Key=system.profiles.checking}"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="ProfileCleanupButton" Content="{l:Str Key=common.delete}"
                        Click="ProfileCleanupButton_Click" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- Backup and Restore -->
        <TextBlock Text="{l:Str Key=system.backup.section}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE777;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{l:Str Key=system.backup.title}" FontSize="14" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Str Key=system.backup.export}" Click="ExportButton_Click"/>
                    <Button Content="{l:Str Key=system.backup.import}" Click="ImportButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>